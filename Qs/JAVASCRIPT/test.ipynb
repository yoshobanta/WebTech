   "source": [
    "# Strong Number\n",
    "def fact(n):\n",
    "    if n == 0 or n == 1:\n",
    "        return 1\n",
    "    return n * fact(n-1)\n",
    "\n",
    "def chk_strong(n):\n",
    "    res = 0\n",
    "    temp = n\n",
    "    while (temp > 0) :\n",
    "        ld = temp % 10\n",
    "        res += fact(ld)\n",
    "        temp //= 10\n",
    "    return n == res\n",
    "chk_strong(145)"
   ]
  }
 ],
